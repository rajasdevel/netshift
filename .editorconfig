# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.go,go.mod,Makefile}]
indent_style = tab

[*.md]
indent_style = space
indent_size = 2
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{yml,yaml,json,sh}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
